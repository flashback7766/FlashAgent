# Maintainer: flashback7766 <https://github.com/flashback7766>
pkgname=flashagent-bin
pkgver=b250
pkgrel=1
pkgdesc="Fast, local-first autonomous AI coding agent in pure Rust"
arch=('x86_64')
url="https://github.com/flashback7766/FlashAgent"
license=('MIT')
depends=('gcc-libs' 'glibc')
provides=('flashagent')
conflicts=('flashagent')

package() {
    install -Dm755 "${srcdir}/flashagent" "${pkgdir}/usr/bin/flashagent"
    install -Dm644 "${srcdir}/flashagent.desktop" "${pkgdir}/usr/share/applications/flashagent.desktop"
    install -Dm644 "${srcdir}/flashagent.png" "${pkgdir}/usr/share/icons/hicolor/256x256/apps/flashagent.png"
    install -Dm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
