# ~/.config/systemd/user/flashagent-serve-users.service
[Unit]
Description=FlashAgent serve — the users' room's brain (compact tier, manual mode)
After=network-online.target

[Service]
ExecStart=%h/.local/bin/flashagent --serve --dir %h/RXPlaya/reports --port 8094 --prompt compact --effort low --mode manual
Environment=FLASHAGENT_SERVE_TOKEN=rx-users-2026
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
