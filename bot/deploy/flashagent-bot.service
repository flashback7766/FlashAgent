# ~/.config/systemd/user/flashagent-bot.service
[Unit]
Description=FlashAgent Telegram bot (all rooms)
After=flashagent-serve-dev.service flashagent-serve-users.service

[Service]
WorkingDirectory=%h/RXPlaya/bot
# The v2 entry point: the package module, the config as the only argument.
ExecStart=%h/RXPlaya/bot/venv/bin/python -m flashagent_bot bot.toml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
