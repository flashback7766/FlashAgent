# ~/.config/systemd/user/flashagent-bot.service
[Unit]
Description=FlashAgent Telegram bot (all rooms)
After=flashagent-serve-dev.service flashagent-serve-users.service

[Service]
WorkingDirectory=%h/RXPlaya/bot
ExecStart=%h/RXPlaya/bot/venv/bin/python bot.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
